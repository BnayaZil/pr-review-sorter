{
  "manifest_version": 3,
  "name": "PR Review Sorter",
  "version": "1.0.0",
  "description": "Reorders a GitHub PR's changed files and highlights/comments lines, from a review plan a code agent encodes in the URL.",
  "homepage_url": "https://github.com/BnayaZil/pr-review-sorter",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*/pull/*"],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "background.js" },
  "host_permissions": [
    "https://api.github.com/*",
    "https://gist.githubusercontent.com/*",
    "https://raw.githubusercontent.com/*"
  ]
}
